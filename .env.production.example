APP_ENV=production
DATABASE_URL=sqlite:///./data/reviewagentai.db
CORS_ORIGINS=https://your-frontend-domain.example
GROQ_API_KEY=replace-in-secret-manager
GROQ_MODEL=openai/gpt-oss-120b
REVIEW_SESSION_TIMEOUT_MINUTES=30
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
PRIVATE_FEEDBACK_RATE_LIMIT_REQUESTS=5
PRIVATE_FEEDBACK_RATE_LIMIT_WINDOW_SECONDS=60
BUSINESS_API_KEY=replace-in-secret-manager

# Authentication signing secret. Use a long random value in production.
AUTH_SECRET=change-this-to-a-long-random-secret
DEMO_AUTH_SEED=false

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_LOG_ENABLED=true
