APP_ENV=development
DATABASE_URL=sqlite:///./reviewagentai.db
CORS_ORIGINS=http://localhost:5173
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b

# AI generation is optional. The application uses safe fallback text if Groq is unavailable.

REVIEW_SESSION_TIMEOUT_MINUTES=30

# MVP protection for positive-review generation endpoint
AI_RATE_LIMIT_REQUESTS=10
AI_RATE_LIMIT_WINDOW_SECONDS=60

# Authentication signing secret. Use a long random value in production.
AUTH_SECRET=change-this-to-a-long-random-secret
DEMO_AUTH_SEED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFICATION_FROM_EMAIL=
NOTIFICATION_TO_EMAIL=
BILLING_PROVIDER=MOCK

# Phase 19 production hardening
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUDIT_LOG_ENABLED=true
